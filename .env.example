# Development-only values for Docker Compose. Do not commit a real .env file.
POSTGRES_DB=pulse
POSTGRES_USER=pulse
POSTGRES_PASSWORD=change-this-local-postgres-password

# Base64-encoded development JWT key. Generate a unique value before any shared deployment.
PULSE_JWT_SECRET=Y2hhbmdlLXRoaXMtMzItYnl0ZS1kZXYtc2VjcmV0LWtleSE=
PULSE_OLLAMA_MODEL=qwen2.5:1.5b
# Used by the local RAG service to turn incident text into searchable vectors.
PULSE_OLLAMA_EMBEDDING_MODEL=embeddinggemma

# Created only in the Docker profile. Change these before sharing a deployed environment.
PULSE_BOOTSTRAP_ADMIN_NAME=Pulse Docker Admin
PULSE_BOOTSTRAP_ADMIN_EMAIL=admin@pulse.local
PULSE_BOOTSTRAP_ADMIN_PASSWORD=PulseDockerPass!2026
PULSE_BOOTSTRAP_ADMIN_TEAM_NAME=Platform Operations

# Used only by Prometheus to scrape protected metrics inside Docker.
PULSE_METRICS_USERNAME=pulse-metrics
PULSE_METRICS_PASSWORD=PulseMetricsDevOnly!2026

# Grafana local administrator account. Change before sharing an environment.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=GrafanaDevOnly!2026
